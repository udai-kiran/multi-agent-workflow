{
  "workers": {
    "dsh": {
      "bin": "dsh-worker",
      "model": "deepseek-flash (profile-managed)",
      "provider": "deepseek-official",
      "supports_persona": true,
      "env": {}
    },
    "pi-kimi": {
      "bin": "pi-worker",
      "model": "openrouter/moonshotai/kimi-k3",
      "provider": "openrouter",
      "supports_persona": true,
      "env": {
        "PI_WORKER_MODEL": "openrouter/moonshotai/kimi-k3",
        "PI_WORKER_NAME": "pi-kimi"
      }
    },
    "pi-glm": {
      "bin": "pi-worker",
      "model": "opencode/glm-5.3",
      "provider": "opencode",
      "supports_persona": true,
      "env": {
        "PI_WORKER_MODEL": "opencode/glm-5.3",
        "PI_WORKER_NAME": "pi-glm"
      }
    },
    "codex": {
      "bin": "codex-worker",
      "model": "gpt-5.6-terra",
      "provider": "openai",
      "supports_persona": false,
      "env": {}
    }
  },
  "selection": {
    "cold_start_order": [
      "dsh",
      "pi-kimi",
      "pi-glm"
    ],
    "min_samples": 5,
    "min_pass_rate": 0.70,
    "overrides": {}
  },
  "fallback": "sonnet-worker"
}
