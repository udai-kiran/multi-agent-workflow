{
  "coordinator": {
    "provider": "anthropic",
    "model": "claude-opus-5-5",
    "mechanism": "top-level subagent (loop: true)"
  },
  "primary-implementer": {
    "provider": "openai",
    "model": "gpt-6.1-sol",
    "reasoning": "medium",
    "mechanism": "codex-worker bin (CODEX_WORKER_MODEL=gpt-6.1-sol CODEX_WORKER_REASONING=medium; these are the bin defaults)",
    "alias": "sol"
  },
  "mechanical-worker": {
    "provider": "openai",
    "model": "gpt-6-luna",
    "reasoning": "high",
    "mechanism": "codex-worker bin (CODEX_WORKER_MODEL=gpt-6-luna CODEX_WORKER_REASONING=high)",
    "alias": "luna"
  },
  "research-worker": {
    "provider": "google-antigravity",
    "model": null,
    "mechanism": "agy-worker bin; research-worker brief; optional AGY_WORKER_EFFORT",
    "model_env": "AGY_WORKER_MODEL",
    "effort_env": "AGY_WORKER_EFFORT"
  },
  "verification-engineer": {
    "provider": "google-antigravity",
    "model": null,
    "mechanism": "agy-worker bin; verification-engineer brief; optional AGY_WORKER_EFFORT",
    "model_env": "AGY_WORKER_MODEL",
    "effort_env": "AGY_WORKER_EFFORT"
  },
  "plan-reviewer": {
    "provider": "openai",
    "model": "gpt-6.1-sol",
    "reasoning": "high",
    "mechanism": "codex-reviewer bin (CODEX_REVIEWER_REASONING=high), read-only sandbox"
  },
  "plan-reviewer-secondary": {
    "provider": "openai",
    "model": "gpt-6-luna",
    "reasoning": "high",
    "mechanism": "codex-reviewer bin (CODEX_REVIEWER_MODEL=gpt-6-luna CODEX_REVIEWER_REASONING=high), read-only sandbox",
    "alias": "luna-plan-review"
  },
  "correctness-reviewer": {
    "provider": "openai",
    "model": "gpt-6.1-sol",
    "reasoning": "medium",
    "mechanism": "codex-reviewer bin, read-only sandbox",
    "alias": "codex-reviewer"
  },
  "adversarial-reviewer": {
    "provider": "openai",
    "model": "gpt-6.1-sol",
    "reasoning": "high",
    "mechanism": "codex-reviewer bin (CODEX_REVIEWER_REASONING=high), read-only sandbox"
  },
  "contrarian": {
    "provider": "openai",
    "model": "gpt-6.1-sol",
    "reasoning": "high",
    "mechanism": "codex-reviewer bin (CODEX_REVIEWER_REASONING=high), read-only sandbox, re-plan only"
  },
  "doc-writer": {
    "provider": "google-antigravity",
    "model": null,
    "mechanism": "agy-worker bin; doc-writer brief; optional AGY_WORKER_EFFORT",
    "model_env": "AGY_WORKER_MODEL",
    "effort_env": "AGY_WORKER_EFFORT"
  },
  "agy-implementer": {
    "provider": "google-antigravity",
    "model": null,
    "mechanism": "agy-worker bin; fallback or disjoint implementation brief",
    "model_env": "AGY_WORKER_MODEL",
    "effort_env": "AGY_WORKER_EFFORT"
  }
}
