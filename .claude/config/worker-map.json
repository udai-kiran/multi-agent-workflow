{
  "coordinator": {
    "provider": "anthropic",
    "model": "claude-opus-5-5",
    "mechanism": "top-level subagent (loop: true)"
  },
  "primary-implementer": {
    "provider": "openai",
    "model": "gpt-6.1-sol",
    "reasoning": "medium",
    "mechanism": "codex-worker bin (CODEX_WORKER_MODEL=gpt-6.1-sol CODEX_WORKER_REASONING=medium; these are the bin defaults)",
    "alias": "sol"
  },
  "mechanical-worker": {
    "provider": "openai",
    "model": "gpt-6-luna",
    "reasoning": "high",
    "mechanism": "codex-worker bin (CODEX_WORKER_MODEL=gpt-6-luna CODEX_WORKER_REASONING=high)",
    "alias": "luna"
  },
  "research-worker": {
    "provider": "anthropic",
    "model": "claude-haiku-5-5",
    "mechanism": "subagent, read-only"
  },
  "verification-engineer": {
    "provider": "anthropic",
    "model": "claude-sonnet-5-5",
    "mechanism": "subagent, permissionMode: acceptEdits"
  },
  "plan-reviewer": {
    "provider": "anthropic",
    "model": "claude-opus-5-5",
    "mechanism": "subagent, read-only"
  },
  "plan-reviewer-secondary": {
    "provider": "openai",
    "model": "gpt-6.1-sol",
    "reasoning": "high",
    "mechanism": "codex-reviewer bin (CODEX_REVIEWER_REASONING=high), read-only sandbox",
    "alias": "sol-plan-review"
  },
  "correctness-reviewer": {
    "provider": "openai",
    "model": "gpt-6.1-sol",
    "reasoning": "medium",
    "mechanism": "codex-reviewer bin, read-only sandbox",
    "alias": "codex-reviewer"
  },
  "adversarial-reviewer": {
    "provider": "anthropic",
    "model": "claude-opus-5-5",
    "mechanism": "subagent, read-only"
  },
  "contrarian": {
    "provider": "anthropic",
    "model": "claude-opus-5-5",
    "mechanism": "subagent, read-only, re-plan only"
  },
  "doc-writer": {
    "provider": "anthropic",
    "model": "claude-haiku-5-5",
    "mechanism": "subagent, permissionMode: acceptEdits, comments and docs only"
  }
}
